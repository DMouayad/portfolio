---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import ProjectHeader from "@/components/project/ProjectHeader.astro";
import ProjectInfoCard from "@/components/project/ProjectInfoCard.astro";
import ProjectLink from "@/components/project/ProjectLink.astro";

export async function getStaticPaths() {
    const projects = await getCollection("project");
    const projectCount = projects.length;
    return projects.map((project, index) => ({
        params: { id: project.id },
        props: {
            project,
            prevProject:
                index + 1 !== projectCount ? projects[index + 1] : null,
            nextProject: index !== 0 ? projects[index - 1] : null,
        },
    }));
}

type Props = {
    project: CollectionEntry<"project">;
    prevProject: CollectionEntry<"project">;
    nextProject: CollectionEntry<"project">;
};

const { project, prevProject, nextProject } = Astro.props;
const { title, shortDesc, images, tags, links } = project.data;
const introImage = images.at(0);
const { Content } = await render(project);
---

<BaseLayout title={title} description={shortDesc}>
    <ProjectHeader />
    <div
        class="w-screen absolute -z-10 bg-black bottom-auto h-[676px] left-0% max-lg:h-600 max-md:h-500 max-sm:h-450 right-0 top-0"
    >
    </div>
    <div
        class="mx-auto max-md:mx-10 max-sm:mx-5 max-xl:mx-20 max-md:pt-[20px] max-sm:pt-[60px] max-w-6xl pt-[100px] relative"
    >
        <div class="fade-up-box !mb-20">
            <div
                id="title-box"
                class="fade-up-item fixed top-0 left-0 right-0 mx-auto z-20 w-fit"
            >
                <div id="title"
                    class="transition-all duration-300  text-white font-semibold leading-[76px] max-lg:leading-[68px] max-md:leading-[60px] max-sm:leading-[52px] tracking-tight"
                >
                    {title}
                </div>
            </div>
            <div
                id="img"
                class="fade-up-item fade-up-delay-none w-full h-[600px] md:mt-32 mt-28 "
            >
                <Image
                    class:list="w-full h-full bg-cover object-cover bg-center rounded-xl"
                    src={introImage}
                    loading="lazy"
                    decoding="async"
                    height="800"
                    quality="high"
                    alt={"Project '" + title + "' banner"}
                />
            </div>
        </div>
        <div class="fade-up-box !mb-20">
            <div
                id="info-cards"
                class="fade-up-item flex justify-between max-lg:flex-col max-lg:gap-10 max-sm:gap-5 max-xl:gap-5 mb-20"
            >
                <ProjectInfoCard title="Type"
                    >University Course Project</ProjectInfoCard
                >
                <ProjectInfoCard title="TechStack"
                    >{tags.join(" - ")}</ProjectInfoCard
                >
                <ProjectInfoCard title="Links"
                    >{
                        links.map((el) => (
                            <a
                                class="btn btn-link text-base text-black"
                                href={el.url}
                            >
                                {el.label}
                            </a>
                        ))
                    }</ProjectInfoCard
                >
            </div>
            <div
                class="fade-up-item relative max-w-none prose sm:prose font-semibold md:max-w-screen-lg md:mx-auto h-fit"
            >
                <Content />
            </div>

            <div
                class="fade-up-item w-full mt-16 mb-10 h-1 border-y border-black"
            >
            </div>
            {
                (prevProject || nextProject) && (
                    <h2 class="fade-up-item font-serif italic mb-4">View Also:</h2>
                    <div class="fade-up-item flex flex-col md:flex-row items-center gap-x-5">
                        {nextProject && <ProjectLink project={nextProject} />}
                        {prevProject && <ProjectLink project={prevProject} />}
                    </div>
                )
            }
        </div>
    </div>

    </BaseLayout>
    <style>
        #title-box.fade-up-item {
            transition: 1.2s ease;
        }
        #img.fade-up-item {
            transition: 0.8s ease;
        }
        #info-cards.fade-up-item {
            transition: 1s ease;
        }
        #title{
            padding-top: max(env(safe-area-inset-top), 8px);
        }
    </style>

<script>
    const titleEl =document.getElementById('title')
window.onload = function() {
    if(titleEl){
        const initialClasses=["mt-40", "text-4xl", "md:text-6xl"]
        const scrolledClasses = ["mt-0",  "lg:mt-4", "text-xl", "md:text-3xl" ]
        titleEl?.classList.add(...initialClasses)
    window.addEventListener('scroll',()=>{
           const condition=window.scrollY >= 100
           if(condition){
               titleEl?.classList.add(...scrolledClasses)
               titleEl?.classList.remove(...initialClasses)
           }else{
            titleEl?.classList.remove(...scrolledClasses)
            titleEl?.classList.add(...initialClasses)
           }
        })
    }
}

</script>