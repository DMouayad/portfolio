---
interface Props {
    link: string;
    title: string;
    isInDropMenu: boolean;
}
const { link, title, isInDropMenu = false } = Astro.props;
---

<li class={isInDropMenu ? "" : "text-white text-base"}>
    <a class={isInDropMenu ? "p-6 text-xl" : ""} href=`${link}`>{title}</a>
</li>

<style>
    li {
        @apply drop-shadow-sm font-semibold  hover:bg-base-100 hover:text-black transition-all duration-200 rounded-md;
        a {
            @apply px-6;
        }
    }
</style>
