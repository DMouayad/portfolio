---
import DivImage from "../DivImage.astro";
import avatar from "../../images/avatar.png";
import { siteData } from "@/data/siteData";
---

<div
    class="h-screen relative flex flex-col items-center sm:items-start justify-center max-w-lg sm:max-w-[80vw] xl:max-w-6xl mx-auto"
>
    <div
        class="flex sm:flex-col flex-wrap h-40 max-w-xs justify-center md:max-w-sm gap-x-6"
    >
        <DivImage
            classList="h-32 w-32 bg-cover rounded-2xl bg-blend-multiply "
            options={{ src: avatar }}
        />
        <div class="name" style="font-family: Almarai">
            {siteData.hero.nameArabic}
        </div>
        <div class="name">{siteData.hero.name}</div>
        <div class="text-2xl mt-6 text-base-300 drop-shadow-sm">
            Software Engineer
        </div>
    </div>
    <div class="text-4xl"></div>
</div>

<style>
    .name {
        @apply text-2xl md:text-4xl font-bold text-white !leading-snug;
    }
</style>
