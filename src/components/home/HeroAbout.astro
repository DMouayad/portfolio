---
import { Image } from "astro:assets";
import avatar from "../../images/avatar.png";
import { siteData } from "@/data/siteData";
import { Icon } from "astro-icon/components";
---

<div
    class="h-screen relative flex flex-col items-center sm:items-start justify-around sm:justify-center max-w-[80vw] sm:max-w-[80vw] xl:max-w-6xl mx-auto"
>
    <div
        class="flex sm:flex-col flex-wrap justify-center h-40 max-w-xs md:max-w-sm gap-x-6 gap-y-3 sm:gap-y-0"
    >
        <Image
            class="h-[140px] w-[120px] rounded-2xl"
            src={avatar}
            width="300"
            height="300"
            quality="100"
            alt="A Portrait of myself"
        />
        <div class="name" style="font-family: Almarai">
            {siteData.hero.nameArabic}
        </div>
        <div class="name">{siteData.hero.name}</div>
        <div class="flex w-full mt-5 gap-3 justify-center sm:justify-start">
            {
                Object.values(siteData.contactInfo).map((item) => (
                    <a
                        class="text-base-300 hover:text-white"
                        target="_blank"
                        href={item.url}
                        aria-label={item.buttonLabel}
                    >
                        <Icon name={item.icon} class="w-7 h-7" />
                    </a>
                ))
            }
        </div>
    </div>
    <div class="mt-24 mb-8">
        <div class="text-4xl text-white drop-shadow-sm">
            {siteData.hero.aboutMeTitle}
        </div>
        <div class="text-xl mt-9 text-base-300 shadow-base-300">
            {siteData.hero.aboutMeText}
        </div>
    </div>
</div>

<style>
    .name {
        @apply text-2xl md:text-4xl font-bold text-white !leading-snug;
    }
</style>
