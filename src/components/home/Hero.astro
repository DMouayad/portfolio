---
import DivImage from "../DivImage.astro";
import introImg from "../../images/intro.jpg";
---

<section id="intro" class="text-center" style="scrollbar-color: black black;">
    <DivImage
        classList="bg-cover  bg-center h-screen  w-screen flex flex-col items-center  justify-center"
        options={{ src: introImg }}
    >
        <h1
            class="text-6xl lg:text-8xl font-semibold text-white backdrop-blur-sm md:backdrop-blur-none"
        >
            Mouayad AlHamwi
        </h1>
        <h2 class="mt-6 text-3xl font-semibold text-base-200 drop-shadow-sm">
            Software Engineer
        </h2>
    </DivImage>
</section>
