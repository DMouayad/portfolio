---
import { getCollection } from "astro:content";
import ProjectCard from "../ProjectCard.astro";

const projects = await getCollection("project");
---

<section class="projects-section pt-48" id="projects">
    <div
        class="flex flex-col md:flex-row justify-around items-center mb-11 section-container"
    >
        <div class="md:w-2/6 text-center md:text-left mb-12 md:mb-0">
            <span class="projects-title">Projects</span>
            <h3 class="projects-heading">Practice makes perfect</h3>
        </div>
        <div class="md:w-2/6">
            <p class="projects-text-content">
                "One good work is better than countless bad ones"
            </p>
        </div>
    </div>

    <div id="projects-list" class="space-holder">
        <div class="sticky">
            <div class="horizontal">
                <section role="feed" class="cards">
                    {
                        projects.map((project) => (
                            <ProjectCard class:list="" project={project} />
                        ))
                    }
                </section>
            </div>
        </div>
    </div>
</section>
<script src="src/assets/horizontalScroll"></script>
<script src="src/assets/projects"></script>
<style>
    .scrollbar-hide::-webkit-scrollbar {
        display: none;
    }

    .space-holder {
        position: relative;
        width: 100%;
    }

    .sticky {
        position: sticky;
        top: 0;
        height: fit-content;
        width: 100%;
        overflow: hidden;
    }

    .horizontal {
        height: 100%;
        height: fit-content;

        position: relative;
    }

    .cards {
        position: relative;
        width: max-content;
        flex-flow: row nowrap;
        background-color: transparent;
        @apply h-fit md:h-screen;
        @apply py-5;
        @apply sm:pe-48 px-10 sm:ps-40;
        @apply grid grid-cols-2 lg:grid-cols-3 grid-rows-2  justify-center items-center grid-flow-row gap-4 gap-x-5;
    }

    .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .projects-section {
        transition: all 0.3s ease;
        position: relative;
        height: fit-content;
        @apply pt-28 dark:text-white relative;
        &.dark {
            @apply bg-dark;
        }
    }
    .projects-title {
        transition: color 0.3s ease;
        @apply font-serif;
        @apply text-gray-500 dark:text-gray-400 text-lg font-normal;
    }
    .projects-heading {
        @apply text-5xl lg:leading-tight lg:text-6xl font-semibold  text-gray-800 dark:text-white mt-3 mb-7 transition-colors;
    }
    .projects-text-content {
        @apply leading-relaxed md:ml-20 mt-3 dark:text-base-100 italic;
    }
</style>
