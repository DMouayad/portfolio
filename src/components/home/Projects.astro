---
import { getCollection } from "astro:content";
import ProjectCard from "../ProjectCard.astro";

const projects = await getCollection("project");
---

<section class="projects-section pt-48" id="projects">
    <div class="flex flex-col md:flex-row items-center mb-11 section-container">
        <div class="md:w-1/6"></div>
        <div class="md:w-3/6 text-center md:text-left mb-12 md:mb-0">
            <span class="projects-title">Projects</span>
            <h3 class="projects-heading">Practice makes perfect</h3>
            <p class="projects-text-content">
                One good work is better than countless bad ones. Not to be an
                assembly line employee, only to produce best crafted products.
            </p>
        </div>
        <div class="md:w-1/2 relative flex justify-center circular-text">
            <div class="circular-wrapper">
                <div class="rotate-text">
                    <svg viewBox="0 0 220 220">
                        <path
                            id="curve"
                            d="M 110 110, m -90, 0 a 90,90 0 1,1 180,0 a 90,90 0 1,1 -180,0"
                            fill="transparent"></path>
                        <text>
                            <textPath
                                xlink:href="#curve"
                                style="font-size: 21.5px;"
                            >
                                Portfolio — Portfolio — Portfolio — Portfolio —
                                Portfolio — Portfolio — Portfolio — Portfolio —
                            </textPath>
                        </text>
                    </svg>
                </div>
                <div class="counter">
                    <span class="text-4xl">♾️</span>
                </div>
            </div>
        </div>
    </div>

    <div id="projects-list" class="space-holder">
        <div class="sticky">
            <div class="horizontal">
                <section role="feed" class="cards">
                    {
                        projects.map((project) => (
                            <ProjectCard class:list="" project={project} />
                        ))
                    }
                </section>
            </div>
        </div>
    </div>
</section>
<script src="src/assets/horizontalScroll"></script>
<script src="src/assets/projects"></script>
<style>
    .scrollbar-hide::-webkit-scrollbar {
        display: none;
    }

    .space-holder {
        position: relative;
        width: 100%;
    }

    .sticky {
        position: sticky;
        top: 0;
        height: fit-content;
        width: 100%;
        overflow: hidden;
    }

    .horizontal {
        height: 100%;
        height: fit-content;

        position: relative;
    }

    .cards {
        position: relative;
        width: max-content;
        flex-flow: row nowrap;
        background-color: transparent;
        @apply h-fit md:h-screen;
        @apply py-5;
        @apply sm:pe-48 px-10 sm:ps-40;
        @apply grid grid-cols-2 lg:grid-cols-3 grid-rows-2  justify-center items-center grid-flow-row gap-4 gap-x-5;
    }

    .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .projects-section {
        transition: all 0.3s ease;
        position: relative;
        height: fit-content;
        @apply pt-28 dark:text-white relative;
        &.dark {
            @apply bg-dark;
        }
    }
    .projects-title {
        transition: color 0.3s ease;
        @apply font-serif;
        @apply text-gray-500 dark:text-gray-400 text-lg font-normal;
    }
    .projects-heading {
        @apply text-5xl lg:leading-tight lg:text-6xl font-semibold  text-gray-800 dark:text-white mt-3 mb-7 transition-colors;
    }
    .projects-text-content {
        @apply leading-relaxed md:ml-20 mt-3 dark:text-base-100;
    }

    .circular-text {
        @apply flex justify-center items-center;
    }

    .circular-wrapper {
        @apply relative w-[300px] h-[300px] max-w-[30vw] max-h-[30vw] overflow-hidden;
        &:hover {
            .rotate-text {
                animation: rotate-text 1s linear infinite;
            }
        }
    }

    .rotate-text {
        will-change: auto;
        @apply w-full h-full; /* animate-spin is from Tailwind */
        animation: rotate-text 10s linear infinite; /* Keep the keyframes */
    }

    .counter {
        @apply w-1/2 h-1/2 absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 flex flex-col justify-center items-center text-center;
    }

    textPath {
        @apply transition-all duration-300 fill-black dark:fill-white;
    }
    @keyframes rotate-text {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }
</style>
