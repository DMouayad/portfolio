---
import { getCollection } from "astro:content";

const experiences = await getCollection("experience");
---

<div class="h-32"></div>
<section id="experience-section" class="main-section">
    <div
        class="fade-up-box section-container flex flex-col justify-center items-center flex-nowrap"
    >
        <div class="fade-up-item text-xl md:text-2xl">Experiences</div>
        <div
            class="text-5xl sm:text-6xl text-center font-semibold mt-5 fade-up-item !duration-7000"
        >
            Experience is a Great Teacher
        </div>
    </div>
    {
        experiences.map((e) => (
            <div class=`part ${e.data.cssClasses}`>
                <div class="part-wrapper drop-shadow-sm">
                    <div class="flex justify-between items-center">
                        <span>{e.data.upperTitle}</span>
                        {e.data.link && 
                        <a
                        class="btn btn-link font-serif text-base hover:btn-outline"
                        class:list={e.data.link.css}
                        target="_blank"
                        href={e.data.link.url}
                        aria-label={e.data.link.ariaLabel}
                        >
                            {e.data.link.text}
                        </a>
                        }
                    </div>
                    <div class="title text-center">{e.data.title}</div>
                    <p>
                      {e.body}
                    </p>
                </div>
            </div>
        ))
    }
</section>

<style>
    .main-section {
        height: fit-content;
    }
    .part-wrapper {
        @apply max-w-md md:max-w-2xl;
    }
    .part {
        padding: 10px;
        position: sticky;
        width: 100vw;
        height: 100vh;
        top: 0;
        box-sizing: border-box;
        @apply flex flex-col items-center justify-center;
        @apply drop-shadow-md;
        background-attachment: fixed;
        p {
            text-align: center;
        }
    }

    .title {
        @apply text-6xl my-16 md:my-12;
    }
</style>
