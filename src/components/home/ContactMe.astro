---
import { MY_CONTACTS } from "@/constants";
import { Icon } from "astro-icon/components";
---

<section id="contact-section">
    <div class="flex flex-col h-full justify-center items-center">
        <div class="text-5xl font-bold">Get in Touch</div>
        <div class="my-8 flex items-center justify-center gap-4">
            {
                Object.values(MY_CONTACTS).map((item) => {
                    return (
                        <a
                            class="btn text-black  lg:btn-ghost min-w-[80px] lg:min-w-[64px] h-[54px] lg:h-auto duration-500"
                            target="_blank"
                            href={item.url}
                            aria-label={item.buttonLabel}
                        >
                            <Icon name={item.icon} class="w-7 h-7" />
                        </a>
                    );
                })
            }
        </div>
    </div>
</section>
