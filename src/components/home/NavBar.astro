---
import NavBarItems from "../NavBarItems.astro";
---

<div class="h-[90px] lg:py-4 px-8 top-6 sm:top-3 left-0 z-[999] fixed w-full">
    <div
        id="nav"
        class="navbar w-fit mx-auto rounded-md bg-base-100 md:bg-transparent shadow md:shadow-none md:backdrop-blur-md"
    >
        <div class="navbar-start">
            <div class="dropdown">
                <div
                    id="nav-dropdown"
                    tabindex="0"
                    role="button"
                    class="btn btn-ghost lg:hidden"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M4 6h16M4 12h8m-8 6h16"></path>
                    </svg>
                </div>
                <ul
                    tabindex="0"
                    class="menu menu-sm dropdown-content bg-base-100 rounded-md z-[1] mt-3 w-[80vw] lg:w-48 p-2 drop-shadow-md"
                >
                    <NavBarItems isInDropdownMenu={true} />
                </ul>
            </div>
        </div>
        <div id="nav-menu" class="navbar-center hidden lg:flex">
            <ul class="menu menu-horizontal px-1">
                <NavBarItems isInDropdownMenu={false} />
            </ul>
        </div>
        <div class="navbar-end"></div>
    </div>
</div>

<script>
    const nav = document.getElementById("nav");
    const navMenu = document.getElementById("nav-menu");
    const navDropdown = document.getElementById("nav-dropdown");

    if (window.screen.availWidth > 640) {
        window.addEventListener("scroll", function () {
            const scrollY = window.scrollY; // Get current scroll position
            const condition = scrollY > window.screen.availHeight * 0.8;
            navMenu?.classList.toggle("lg:flex", !condition);
            navDropdown?.classList.toggle("lg:hidden", !condition);
            nav?.classList.toggle("mx-auto", !condition);
        });
    } else {
        nav?.classList.remove("mx-auto");
    }
</script>
