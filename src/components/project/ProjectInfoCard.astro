---
interface Props {
    title: string;
    classList?: string;
    rest?: [];
}
const { title, classList = "", ...rest } = Astro.props;
---

<div
    class="rounded-xl border border-black h-32 w-[85vw] m-auto lg:w-[350px] flex flex-col items-center justify-center"
    class:list={classList}
    {...rest}
>
    <div
        class="font-serif text-black tracking-tight font-semibold leading-10 text-3xl text-center"
    >
        {title}
    </div><div class="font-normal leading-7 text-lg mt-3 text-center">
        <slot />
    </div>
</div>
