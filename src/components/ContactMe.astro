---
import { MY_CONTACTS } from "@/constants";
import { Icon } from "astro-icon/components";
const currentDate = new Date().toDateString();
---

<section id="contact-section">
    <div class="flex flex-col h-full items-center">
        <div class="flex-grow content-end">
            <div class="text-5xl font-bold">Get in Touch</div>
        </div>
        <div class="w content-center">
            <div class="my-8 flex items-center justify-center gap-4">
                {
                    Object.values(MY_CONTACTS).map((item) => {
                        return (
                            <a target="_blank" href={item.url}>
                                <button class="btn text-black  lg:btn-ghost min-w-[80px] lg:min-w-[64px] h-[54px] lg:h-auto duration-500">
                                    <Icon name={item.icon} class="w-7 h-7" />
                                </button>
                            </a>
                        );
                    })
                }
            </div>
        </div>
        <div class="content-end py-5 flex-1 text-sm">
            Today is <b>{currentDate}</b>
            <span>- Made with 💻</span>
        </div>
    </div>
</section>
