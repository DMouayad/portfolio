---
import DivImage from "./DivImage.astro";
import Badge from "./Badge.astro";
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";
import { BASE_PATH } from "@/constants";

interface Props {
    project: CollectionEntry<"project">;
}
const { project } = Astro.props;
const data = project.data;
---

<article class="project-card group">
    <DivImage
        classList="project-img"
        options={{
            //@ts-ignore
            src: data.images.at(0),
            height: 250,
            quality: 100,
            inferSize: true,
        }}
    />
    <div>
        <div class="project-title">
            {data.title}
        </div>
        <div class="project-desc">
            <p>{data.shortDesc}</p>
        </div>
    </div>

    <div class="self-end content-end z-30">
        {
            data.links.map((link) => (
                <a class="me-1 sm:me-0 " href={link.url} target="_blank">
                    <Badge
                        type="custom"
                        classList="tracking-wide underline sm:text-base-200 lg:text-black flex border-none gap-3 sm:gap-2 font-base transition hover:text-white hover:bg-black"
                    >
                        <Icon name={link.icon} />
                        {link.label}
                    </Badge>
                </a>
            ))
        }
    </div>
    <a
        href={`/${BASE_PATH}/projects/${project.id}/`}
        target="_blank"
        class="h-[100%] delay-300 sm:self-start items-end sm:justify-self-center sm:w-full absolute md:opacity-0 translate-x-0 md:-translate-x-4 will-change-transform transition group-hover:opacity-100 group-hover:translate-x-0 inline-flex bottom-4 sm:gap-1 sm:shrink-0 duration-150 ease-in"
    >
        <div
            class="btn btn-link md:decoration-transparent hover:decoration-current text-lg md:text-sm font-serif font-normal italic px-0"
        >
            <span><Icon name="carbon:arrow-right" /></span>Go to Project
        </div>
    </a>
</article>

<style>
    .project-card {
        @apply w-[360px] h-[360px]  max-w-[80vw];
        @apply flex flex-col relative justify-between;
        @apply outline-base-300 outline-dotted outline-1 lg:outline-none rounded-md hover:-translate-y-2  hover:bg-base-100;
        @apply transition-all duration-500 ease-in-out;
        @apply will-change-transform;
        @apply p-5;
        > div {
            /* @apply group-hover:px-6; */
        }
    }
    .project-img {
        @apply w-full h-[150px] bg-no-repeat bg-cover bg-center rounded-md;
    }
    .project-title {
        @apply mt-5 mb-2 text-xl font-semibold text-gray-800 dark:text-white group-hover:text-gray-800  whitespace-nowrap overflow-ellipsis;
    }
    .project-desc {
        @apply text-gray-600 dark:text-gray-200 group-hover:text-gray-500 overflow-ellipsis text-base;
    }
</style>
