---
import { getCollection } from "astro:content";
import DivImage from "./DivImage.astro";

const projects = await getCollection("projects");
---

<section class="projects-section pt-48" id="projects">
    <div class="flex flex-col md:flex-row items-center">
        <div class="md:w-1/6"></div>
        <div class="md:w-1/2 text-center md:text-left mb-12 md:mb-0">
            <span class="projects-title">Projects</span>
            <h3 class="projects-heading">Practice makes perfect.</h3>
            <p class="projects-text-content">
                One good work is better than countless bad ones. Not to be an
                assembly line employee, only to produce best crafted products.
            </p>
        </div>
        <div class="md:w-1/2 relative flex justify-center circular-text">
            <div class="circular-wrapper">
                <div class="rotate-text">
                    <svg viewBox="0 0 220 220">
                        <path
                            id="curve"
                            d="M 110 110, m -90, 0 a 90,90 0 1,1 180,0 a 90,90 0 1,1 -180,0"
                            fill="transparent"></path>
                        <text>
                            <textPath
                                xlink:href="#curve"
                                style="font-size: 21.5px;"
                            >
                                Portfolio — Portfolio — Portfolio — Portfolio —
                                Portfolio — Portfolio — Portfolio — Portfolio —
                            </textPath>
                        </text>
                    </svg>
                </div>
                <div class="counter">
                    <span class="text-4xl">♾️</span>
                </div>
            </div>
        </div>
    </div>

    <div id="projects-list" class="space-holder">
        <div class="sticky">
            <div class="horizontal">
                <section role="feed" class="cards">
                    {
                        projects.map((project) => (
                            <article class="project-card">
                                <DivImage
                                    classList="project-img"
                                    options={{
                                        src: project.data.images.at(0),
                                        height: 700,
                                        inferSize: true,
                                    }}
                                />
                                <div class="project-title">
                                    {project.data.title}
                                </div>
                                <div class="project-desc">
                                    {project.data.tags.reduce(
                                        (el1, el2) => `${el1}, ${el2}`,
                                    )}
                                </div>
                            </article>
                        ))
                    }
                </section>
            </div>
        </div>
    </div>
</section>
<script async src="/src/assets/horizontalScroll.js"></script>
<script async src="/src/assets/projects.js"></script>
<style>
    .scrollbar-hide::-webkit-scrollbar {
        display: none;
    }

    .container {
        position: relative;
        width: 100%;
        min-height: 100vh;
    }

    .space-holder {
        position: relative;
        width: 100%;
    }

    .sticky {
        position: sticky;
        top: 0;
        height: 100vh;
        width: 100%;
        overflow-x: hidden;
    }

    .horizontal {
        position: absolute;
        height: 100%;
        will-change: transform;
    }

    .cards {
        position: relative;
        height: 100%;
        padding: 0px 0 0 150px;
        display: flex;
        width: 100%;
        flex-flow: row nowrap;
        justify-content: flex-start;
        align-items: center;
        background-color: transparent;
    }

    .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .projects-section {
        transition: all 0.3s ease;
        height: max-content;
        @apply pt-48 dark:text-white relative;
        &.dark {
            @apply bg-[#222];
        }
    }
    .projects-title {
        transition: color 0.3s ease;

        @apply text-gray-500 dark:text-gray-400 text-lg font-semibold;
    }
    .projects-heading {
        @apply text-4xl md:text-5xl lg:text-6xl font-semibold  text-gray-800 dark:text-white my-4 transition-colors;
    }
    .projects-text-content {
        @apply leading-relaxed md:ml-24 dark:text-base-100;
    }

    .project-card {
        @apply w-[550px] h-3/4 max-w-[85vw] flex flex-col justify-center items-start;
        @apply rounded-lg;
        @apply relative;
        margin-right: 75px;
        flex-shrink: 0;
    }
    .project-img {
        @apply w-full h-[280px] bg-center bg-no-repeat bg-cover  mb-8 overflow-hidden rounded-3xl  shadow-md relative flex justify-center items-center cursor-pointer hover:scale-105 transition-transform duration-300;
    }
    .project-title {
        @apply text-2xl font-semibold text-gray-800 dark:text-white whitespace-nowrap overflow-ellipsis;
    }
    .project-desc {
        @apply text-gray-500 dark:text-gray-400 whitespace-nowrap overflow-ellipsis text-lg mb-5 mt-1;
    }

    .circular-text {
        @apply flex justify-center items-center;
    }

    .circular-wrapper {
        @apply relative w-[300px] h-[300px] max-w-[70vw] max-h-[70vw] overflow-hidden;
        &:hover {
            .rotate-text {
                animation: rotate-text 1s linear infinite;
            }
        }
    }

    .rotate-text {
        will-change: auto;
        @apply w-full h-full; /* animate-spin is from Tailwind */
        animation: rotate-text 10s linear infinite; /* Keep the keyframes */
    }

    .counter {
        @apply w-1/2 h-1/2 absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 flex flex-col justify-center items-center text-center;
    }

    textPath {
        @apply transition-all duration-300 fill-black dark:fill-white;
    }
    @keyframes rotate-text {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }
</style>
